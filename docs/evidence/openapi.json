    "/api/employees": {
      "get": {
        "tags": [
          "Employees"
        ],
        "summary": "Get all employees, optionally searched, filtered, sorted and paged.",
        "description": "With no query options every employee is returned. The response header `X-Total-Count` holds the number of\r\nemployees that matched; when paging is used `X-Page` and `X-Page-Size` are added as well.\r\nExample: `GET /api/employees?search=priya&sortBy=Experience&sortOrder=Desc&page=1&pageSize=5`",
        "parameters": [
          {
            "name": "Search",
            "in": "query",
            "description": "Text to look for in the employee name or department (not case-sensitive, matches part of a word).",
            "schema": {
              "type": "string",
              "example": "priya"
            },
            "example": "priya"
          },
          {
            "name": "Department",
            "in": "query",
            "description": "Only employees of exactly this department (not case-sensitive).",
            "schema": {
              "type": "string",
              "example": "Engineering"
            },
            "example": "Engineering"
          },
          {
            "name": "SortBy",
            "in": "query",
            "description": "Field to sort by: Id (default), Name, Department, JoiningDate or Experience.",
            "schema": {
              "$ref": "#/components/schemas/EmployeeSortField"
            }
          },
          {
            "name": "SortOrder",
            "in": "query",
            "description": "Asc (default) or Desc.",
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "description": "Page number, starting at 1. Giving a page (or a page size) turns paging on.",
            "schema": {
              "maximum": 1000000,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "description": "Items per page (1-100). Default when paging: 10.",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "IsPaged",
            "in": "query",
            "description": "True when the client asked for a page rather than the whole list.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EmployeeDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      },

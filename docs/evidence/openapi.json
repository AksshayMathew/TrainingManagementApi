  "components": {
    "schemas": {
      "CourseDto": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "integer",
            "format": "int32"
          },
          "courseName": {
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "integer",
            "description": "Length of the course in hours.",
            "format": "int32"
          },
          "trainerName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "A course as returned by the API."
      },
      "CourseRequestDto": {
        "required": [
          "courseName",
          "duration",
          "trainerName"
        ],
        "type": "object",
        "properties": {
          "courseName": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "description": "Title of the course.",
            "example": "ASP.NET Core Web API Fundamentals"
          },
          "duration": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer",
            "description": "Length of the course in hours. Must be greater than 0. (Nullable here so a missing value is reported instead of becoming 0.)",
            "format": "int32",
            "example": 16
          },
          "trainerName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "Name of the person who delivers the course.",
            "example": "Anita Desai"
          }
        },
        "additionalProperties": false,
        "description": "Data a client sends to create (POST) or fully replace (PUT) a course."
      },
